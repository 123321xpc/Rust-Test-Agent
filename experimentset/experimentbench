#!/usr/bin/env bash
set -euo pipefail
ROOT="$HOME/xpc"
export LD_LIBRARY_PATH="$ROOT/gcc-12/lib:$ROOT/gcc-12/x86_64-conda-linux-gnu/lib:${LD_LIBRARY_PATH:-}"
cd "$ROOT"

foreground=0
dry_or_info=0
args=()

for arg in "$@"; do
  case "$arg" in
    --foreground)
      foreground=1
      ;;
    --background)
      ;;
    --list|--dry-run|-h|--help)
      dry_or_info=1
      args+=("$arg")
      ;;
    *)
      args+=("$arg")
      ;;
  esac
done

if [[ "$foreground" -eq 1 || "$dry_or_info" -eq 1 ]]; then
  exec "$ROOT/envs/rustbench/bin/python" "$ROOT/experimentset/run.py" ${args[@]+"${args[@]}"}
fi

# Default to background: Fail synchronously when configuration or images are unavailable.
"$ROOT/envs/rustbench/bin/python" "$ROOT/experimentset/run.py" ${args[@]+"${args[@]}"} --dry-run
mkdir -p "$ROOT/experimentset/launcher-logs"
log="$ROOT/experimentset/launcher-logs/$(date +%Y%m%d_%H%M%S)_$$.log"
setsid nohup "$ROOT/envs/rustbench/bin/python" "$ROOT/experimentset/run.py" ${args[@]+"${args[@]}"} >"$log" 2>&1 < /dev/null &
printf 'Started PID %s
Log: %s
' "$!" "$log"
exit 0
